---
interface Props {
  href: string
  text: string
}
const { href, text } = Astro.props
---

<a
  class="back-button bg-white hover:bg-black hover:text-white dark:bg-black dark:hover:bg-white dark:hover:text-black focus:animate-flicker motion-reduce:transition-none motion-reduce:hover:transform-none motion-reduce:focus:animation-none text-2xl text-center max-w-fit"
  href={href}
>
  {text}
</a>
