---
interface Props {
  href: string
  text: string
}
const { href, text } = Astro.props
---

<a
  class="bg-white dark:bg-black
  hover:bg-black dark:hover:bg-white
  hover:text-white dark:hover:text-black
  focus:animate-flicker motion-reduce:transition-none motion-reduce:hover:transform-none motion-reduce:focus:animation-none"
  href={href}
>
  {text}
</a>
