---
import Layout from '@/layouts/Layout.astro'
import NavButton from '@/components/NavButton.astro'
---

<Layout title="Home">
  <div class="flex flex-col h-screen w-screen items-center justify-center">
    <p class="text-center text-6xl font-bold leading-tight">
      Nevan Angelo Catoy
    </p>
    <div class="flex flex-col gap-4 mt-8 items-center text-2xl decoration-transparent hover:underline visited:text-light-fg dark:visited:text-dark-fg">
      <NavButton href="/about" text="About Me" />
      <NavButton href="/projects" text="Projects" />
      <NavButton href="/contact" text="Contact" />
    </div>
  </div>
</Layout>
