---
import Layout from '@/layouts/Layout.astro'
import IndexLink from '@/components/IndexLink.astro'

interface Props {
  title: string
}
const { title } = Astro.props
---

<Layout title={title}>
  <div class="flex flex-col h-[80vh] w-[80vw] m-auto">
    <p class="flex-none flex items-center justify-center text-center text-6xl font-bold leading-tight">
      {title}
    </p>

    <IndexLink href="/" text="Back to Home" />
    <div class="flex-1 text-2xl flex items-center justify-center text-center">
      <slot />
    </div>
  </div>
</Layout>
