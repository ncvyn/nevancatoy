---
import Layout from '@/layouts/Layout.astro'
import NavButton from '@/components/NavButton.astro'

interface Props {
  title: string
}
const { title } = Astro.props
---

<Layout title={title}>
  <div class="flex flex-col h-[80vh] w-[80vw] m-auto gap-4">
    <div class="flex flex-col items-center gap-4">
      <p class="text-center text-6xl font-bold leading-tight">{title}</p>

      <NavButton href="/" text="Back to Home" />
    </div>
    <div class="flex-1 text-2xl flex items-center justify-center text-center">
      <slot />
    </div>
  </div>
</Layout>
